# Copy to .env. Every value below has a working default; nothing here is required to run.

# --- Vision ---
FRESHSENSE_CHECKPOINT=artifacts/vit_head.pt
FRESHSENSE_DEVICE=cpu

# --- Decision policy (see docs/MODEL_CARD.md) ---
# Confidence required to CLEAR an item as fresh. Below it (and below the spoiled
# bar) the service abstains and routes to a human.
FRESHSENSE_ABSTAIN_THRESHOLD=0.85
# Spoilage is the safety-critical class: predict "spoiled" on far less evidence
# than we require to clear something as "fresh".
FRESHSENSE_SPOILED_THRESHOLD=0.30

# --- GenAI ---
# Unset -> the deterministic offline explainer runs and the API reports
# llm_mode="offline". Set it to route explanations through Claude.
# ANTHROPIC_API_KEY=sk-ant-...
FRESHSENSE_LLM_MODEL=claude-sonnet-5
FRESHSENSE_LLM_MAX_TOKENS=700
FRESHSENSE_RAG_TOP_K=3

# --- Service ---
FRESHSENSE_LOG_LEVEL=INFO
FRESHSENSE_LOG_JSON=true
